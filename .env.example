# Deploy targets for ./deploy.sh. Copy to .env at the repo root (never commit .env).
# How to use these variables: DEPLOY.md at the repo root. Product and local run: README.md.
# Site content variables (including Google Search Console) live in core/.env.example.
# Keep every secret empty here. Put real values only in the untracked .env file
# or export them in your shell. Do not paste tokens, passwords, or host IPs into this file.

# --- Baota / 宝塔 (SSH) ---
# Host or IP of the server. Required for ./deploy.sh baota.
BT_HOST=
# SSH user. Defaults to root when empty.
BT_USER=
# Absolute app directory on the server. Must not be /. Example: /www/wwwroot/restore-picture
BT_PATH=/www/wwwroot/restore-picture
# SSH port. Defaults to 22.
BT_PORT=22
# Private key path. Defaults to ~/.ssh/id_ed25519, then ~/.ssh/id_rsa.
# Prefer a key when you can. Leave empty when using BT_PASSWORD instead.
BT_SSH_KEY=
# SSH password for username/password upload. When set, deploy.sh uses deploy/ssh-with-password.sh (expect).
# Never commit a real password.
BT_PASSWORD=
# Set to 1 to rsync --delete (removes server files that are not in core/). Off unless you opt in AND pass --yes.
BT_RSYNC_DELETE=
# Optional command run on the server after a successful remote build, for example:
# BT_RESTART_CMD='pm2 reload restore-picture'
BT_RESTART_CMD=

# --- GitHub ---
# owner/name. Used to build https://github.com/owner/name.git
GITHUB_REPOSITORY=
# Or a full remote. git@github.com:owner/name.git does not need a token. https:// does.
GITHUB_REMOTE_URL=
# Branch to update. Defaults to main. Force-push is refused.
GITHUB_BRANCH=main
# Put the token in the environment, not in git:
#   export GITHUB_TOKEN=...
#   export GH_TOKEN=...
# GITHUB_TOKEN=
# GH_TOKEN=

# --- Vercel ---
# Non-interactive production deploy. All three are required for ./deploy.sh vercel --yes.
# Create a token at https://vercel.com/account/tokens
# Org and project ids are in the Vercel project settings (or .vercel/project.json after `vercel link`).
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Optional team slug passed as `vercel --scope`.
VERCEL_SCOPE=
