# Site variables for the Next.js app in this directory.
# Copy to core/.env.local (or core/.env.production on the server). Never commit those files.
# NEXT_PUBLIC_* values are inlined at build time. Rebuild after you change them.
# What each variable does: ../README.md. Deploy steps: ../DEPLOY.md.
#
# Deploy targets (Baota, GitHub, Vercel) are configured at the repo root: ../.env.example

# Public site origin used for canonical URLs, Open Graph, sitemap, and JSON-LD.
# No trailing slash. Required before a production deploy so Google does not
# see http://localhost:3847 as the canonical host.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console HTML-tag verification.
# Paste ONLY the content value, not the whole <meta> tag.
# Example tag:
# <meta name="google-site-verification" content="abc123xyz" />
# Becomes:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID. Leave empty to load no analytics.
# Only IDs shaped like G-XXXXXXXX are accepted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Where "获取说明" / download buttons go.
# Use an https URL when a real build exists, or a site path.
# Default when unset: /download (a placeholder page, no binary).
NEXT_PUBLIC_DOWNLOAD_URL=

# Source repository shown in the footer. Default: /download#source
NEXT_PUBLIC_GITHUB_URL=

# Optional public contact address. Shown as a mailto link when it looks like an email.
NEXT_PUBLIC_CONTACT_EMAIL=
